<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <input>
    <net-file value="city_grid_with_sidewalks.net.xml"/>
    <route-files value="traffic.rou.xml"/>
  </input>
  <time><begin value="0"/><end value="3600"/><step-length value="0.05"/></time>
  <processing><collision.action value="warn"/><time-to-teleport value="120"/></processing>
  <report><no-step-log value="true"/><duration-log.disable value="true"/></report>
</configuration>
