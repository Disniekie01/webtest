<?xml version="1.0" encoding="UTF-8"?>
<!-- Curb delivery robots — looping sidewalk circuits (JuPedSim-friendly). -->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

  <vType id="delivery_robot" vClass="pedestrian"
         desiredMaxSpeed="1.1" speedFactor="1.0"
         width="0.70" length="0.70" height="0.55"
         minGap="0.80" color="1.00,0.62,0.20"
         guiShape="pedestrian"/>

  <!-- Continuous flows + multi-leg out-and-back so bots stay on the curb for the hour.
       Kit still caps follow set via CITYLAB_MAX_ROBOT. -->
  <personFlow id="bot_ns_b" type="delivery_robot" begin="5" end="3600" period="55" departPos="random_free">
    <walk from="SW_NS_1_0_1_R" to="SW_NS_1_3_4_R"/>
    <walk from="SW_NS_1_3_4_R" to="SW_NS_1_0_1_R"/>
    <walk from="SW_NS_1_0_1_R" to="SW_NS_1_3_4_R"/>
    <walk from="SW_NS_1_3_4_R" to="SW_NS_1_0_1_R"/>
  </personFlow>
  <personFlow id="bot_ew_1" type="delivery_robot" begin="12" end="3600" period="60" departPos="random_free">
    <walk from="SW_EW_1_0_1_T" to="SW_EW_1_3_4_T"/>
    <walk from="SW_EW_1_3_4_T" to="SW_EW_1_0_1_T"/>
    <walk from="SW_EW_1_0_1_T" to="SW_EW_1_3_4_T"/>
    <walk from="SW_EW_1_3_4_T" to="SW_EW_1_0_1_T"/>
  </personFlow>
  <personFlow id="bot_ns_br" type="delivery_robot" begin="20" end="3600" period="58" departPos="random_free">
    <walk from="SW_NS_1_3_4_R" to="SW_NS_1_0_1_R"/>
    <walk from="SW_NS_1_0_1_R" to="SW_NS_1_3_4_R"/>
    <walk from="SW_NS_1_3_4_R" to="SW_NS_1_0_1_R"/>
    <walk from="SW_NS_1_0_1_R" to="SW_NS_1_3_4_R"/>
  </personFlow>
  <personFlow id="bot_diag" type="delivery_robot" begin="30" end="3600" period="70" departPos="random_free">
    <walk from="SW_NS_0_0_1_R" to="SW_EW_3_3_4_T"/>
    <walk from="SW_EW_3_3_4_T" to="SW_NS_0_0_1_R"/>
    <walk from="SW_NS_0_0_1_R" to="SW_EW_3_3_4_T"/>
    <walk from="SW_EW_3_3_4_T" to="SW_NS_0_0_1_R"/>
  </personFlow>
</routes>
