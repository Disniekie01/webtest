{
  "Mounts": [
    {
      "source": "/media/disniekie/Working3/CV/Yardline/data/train",
      "destination": "/data"
    },
    {
      "source": "/media/disniekie/Working3/CV/Yardline/data/tao",
      "destination": "/tao"
    },
    {
      "source": "/media/disniekie/Working3/CV/Yardline/weights",
