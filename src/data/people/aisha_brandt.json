  "story": {
    "id": "aisha_plaza_watch",
    "person_id": "aisha_brandt",
    "title": "Watching the plaza learn",
    "summary": "Aisha follows a delivery bot through the plaza and notices who yields — her comfort is high; her story is about everyone else's.",
    "beats": [
      {
        "id": "setup",
        "text": "Aisha sits on the plaza steps with a notebook. A new sidewalk bot route went live this morning; she wants to see the first rush hour before her seminar.\n"
      },
      {
        "id": "approach",
        "text": "She stands when the bot enters from the east edge, matching its pace at a polite distance. Already she sees an elder flinch and a courier cut close.\n"
      },
      {
        "id": "encounter",
        "text": "The bot threads a food line, pauses for a stroller, then commits to a crosswalk just as a bike courier brakes. Two strangers argue — \"those things don't belong here\" — while a teenager films it.\n"
      },
      {
        "id": "reaction",
        "text": "Aisha feels at ease beside the machine. She notes distances, yields, and faces: the elder who flinches, the parent who shrugs, the courier who swears. Comfort, she writes, is unevenly distributed — and the bot's soft chirp before a turn is the only courtesy some people hear.\n"
      },
      {
        "id": "outcome",
        "text": "She walks home beside the bot for a block, smiling when it chirps again. Her story ends with a design question for the city, not a verdict on robots: whose comfort are we optimizing, and who pays when we get it wrong?\n"
      }
    ],
    "themes": [
      "observation",
      "uneven_comfort",
      "inclusive_design"
    ],
