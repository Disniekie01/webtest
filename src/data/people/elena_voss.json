  "story": {
    "id": "elena_evening_shortcut",
    "person_id": "elena_voss",
    "title": "The evening shortcut",
    "summary": "Elena tries a familiar shortcut home and meets a silent delivery bot that forces her into the street — her comfort collapses to zero.",
    "beats": [
      {
        "id": "setup",
        "text": "At dusk Elena leaves the courtyard for the pharmacy, cane tapping a rhythm she trusts. The long way around is safer; tonight her knees argue for the alley shortcut behind the plaza.\n"
      },
      {
        "id": "approach",
        "text": "The alley is quieter than the avenue. She likes that — until quiet means she cannot hear machines either. She keeps to the wall side, counting doorway lights.\n"
      },
      {
        "id": "encounter",
        "text": "Midway through the alley, a delivery bot waits at a doorway, then rolls forward without a sound. Elena does not hear it until its chassis is almost at her hip.\n"
      },
      {
        "id": "reaction",
        "text": "She freezes, then steps sideways into the curb lane to give it room. A scooter horn startles her. Heart racing, she presses herself against a wall and waits for the robot to pass — it stops again, blocking the only clear path.\n"
      },
      {
        "id": "outcome",
        "text": "Elena abandons the shortcut, walks the long way with shaking hands, and tells herself she will not use that alley again until someone promises robots will announce themselves.\n"
      }
    ],
