  "story": {
    "id": "rosa_clinic_ramp",
    "person_id": "rosa_delgado",
    "title": "The clinic ramp",
    "summary": "Rosa guides her mother toward a clinic appointment when a delivery bot claims the only ramp — wariness becomes a fall-risk calculation.",
    "beats": [
      {
        "id": "setup",
        "text": "Rosa checks the appointment text again: 9:40, west entrance, bring the blue folder. Her mother holds her arm, cane tapping a careful rhythm on the sidewalk.\n"
      },
      {
        "id": "approach",
        "text": "The clinic block is quiet until it isn't. A sidewalk bot rolls out of a pharmacy bay and lines up for the same ramp Rosa always uses — the only slope without a lip for the cane.\n"
      },
      {
        "id": "encounter",
        "text": "The bot stops halfway up, amber light blinking. Rosa's mother freezes mid-step. There is no shoulder room; reversing means facing the curb traffic they just escaped.\n"
      },
      {
        "id": "reaction",
        "text": "Rosa talks softly, plants herself between machine and mother, and waits. When the bot finally creeps forward, she mirrors its pace — not trusting a sudden clear. Her own heart rate outruns her comfort score.\n"
      },
      {
        "id": "outcome",
        "text": "They make the appointment three minutes late. Rosa asks the desk for a \"quiet approach window\" and writes the city a complaint that is really a care plan: clear the ramps, or warn early enough that elders never have to choose between a robot and a fall.\n"
      }
    ],
    "themes": [
